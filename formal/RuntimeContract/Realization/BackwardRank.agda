{-# OPTIONS --cubical --safe --guardedness #-}

-- Combinatorial core of the runtime-to-substrate junction: a causal-parent
-- edge strictly decreases event rank, derived from the raw trace's
-- `backwardOK` clause.
--
-- This is the load-bearing lemma behind `Realization.CausalFromParents`:
-- it is what lets a well-formed raw trace generate a genuine (antisymmetric)
-- `CausalOrder`, rather than merely a relation. Everything categorical in
-- the sibling module hangs off `edge-decreases-idx`.
--
-- Design notes:
--
--   * `rank` of an event id is its first-occurrence index (`idx _ eids`).
--     The rank is validation *scaffolding*: it exists only to witness
--     acyclicity. The realized objects downstream are generated by event
--     IDs, not by list position.
--
--   * The single hard step is `go`, an induction mirroring `backwardGo`'s
--     own left-to-right scan. It threads `consumedIds` (ids of already
--     scanned events) alongside `backwardGo`'s `seen`, linked by a
--     membership-equivalence invariant. When the scan reaches the first
--     event carrying the child id `c`, `backwardOK` guarantees each parent
--     already sits in `consumedIds`, while `c` itself does not — and
--     `idx-prefix-lt` turns "in the consumed prefix vs. not" into a strict
--     index inequality.
--
--   * DISTINCTNESS IS NOT NEEDED. `idx-prefix-lt` cares only that the parent
--     is in the consumed prefix and the child is not; it never needs event
--     ids to be globally distinct. (`valid?` does guarantee distinctness for
--     other reasons; the causal order simply does not consume it.)
--
--   * `--safe`: this module is postulate- and hole-free, and imports only the
--     equally-safe raw kernel `RuntimeContract.Trace`. It sees ids as opaque
--     `ℕ` structure, never labels — the same discipline that makes renaming
--     invariance meaningful downstream.

module RuntimeContract.Realization.BackwardRank where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ; zero; suc)
open import Cubical.Data.Nat.Order using (_<_; _≤_; <-trans; suc-≤-suc; zero-≤; <≤-trans)
open import Cubical.Data.Bool using (Bool; true; false; false≢true; true≢false)
open import Cubical.Data.List using (List; []; _∷_; length; _++_)
open import Cubical.Data.List.Properties using (++-assoc)
open import Cubical.Data.Sigma using (_×_; _,_; fst; snd)
open import Cubical.Data.Empty using (rec)

open import RuntimeContract.Trace

open RawEvent

------------------------------------------------------------------------
-- Public API:
--   idx                — first-occurrence index of an id in a list
--   firstEvent         — first event in a list carrying a given id
--   andB-split         — split a Boolean conjunction that holds
--   edge-decreases-idx — the core lemma
------------------------------------------------------------------------

-- first-occurrence index (rank scaffolding).
idx : ℕ → List ℕ → ℕ
idx x []       = 0
idx x (y ∷ ys) = ifB (eqℕ x y) 0 (suc (idx x ys))

-- the first event in a list carrying a given id (default event if none).
private
  defaultEvent : RawEvent
  defaultEvent = mkEvent 0 0 [] [] 0 0

firstEvent : ℕ → List RawEvent → RawEvent
firstEvent c []       = defaultEvent
firstEvent c (e ∷ es) = ifB (eqℕ (evId e) c) e (firstEvent c es)

andB-split : (a b : Bool) → (a andB b) ≡ true → (a ≡ true) × (b ≡ true)
andB-split true  b p = refl , p
andB-split false b p = rec (false≢true p)

------------------------------------------------------------------------
-- Internal lemmas.
------------------------------------------------------------------------

private
  -- prefix/suffix index lemmas: appearing in the prefix P forces a strictly
  -- smaller index than any element whose first occurrence is only in Q.
  idxMemLt : (P Q : List ℕ) (x : ℕ) → (x ∈? P) ≡ true → idx x (P ++ Q) < length P
  idxMemLt [] Q x p = rec (false≢true p)
  idxMemLt (y ∷ ys) Q x p with eqℕ x y
  ... | true  = suc-≤-suc zero-≤
  ... | false = suc-≤-suc (idxMemLt ys Q x p)

  idxNonMemGe : (P Q : List ℕ) (x : ℕ) → (x ∈? P) ≡ false → length P ≤ idx x (P ++ Q)
  idxNonMemGe [] Q x _ = zero-≤
  idxNonMemGe (y ∷ ys) Q x p with eqℕ x y
  ... | true  = rec (true≢false p)
  ... | false = suc-≤-suc (idxNonMemGe ys Q x p)

  idx-prefix-lt : (P Q : List ℕ) (p c : ℕ)
    → (p ∈? P) ≡ true → (c ∈? P) ≡ false
    → idx p (P ++ Q) < idx c (P ++ Q)
  idx-prefix-lt P Q p c pmem cnon =
    <≤-trans (idxMemLt P Q p pmem) (idxNonMemGe P Q c cnon)

  -- Bool / membership helpers.
  orB : Bool → Bool → Bool
  orB true  _ = true
  orB false b = b

  orB-comm : (a b : Bool) → orB a b ≡ orB b a
  orB-comm true  true  = refl
  orB-comm true  false = refl
  orB-comm false true  = refl
  orB-comm false false = refl

  eqℕ-sym : (m n : ℕ) → eqℕ m n ≡ eqℕ n m
  eqℕ-sym zero    zero    = refl
  eqℕ-sym zero    (suc n) = refl
  eqℕ-sym (suc m) zero    = refl
  eqℕ-sym (suc m) (suc n) = eqℕ-sym m n

  eqℕ-sound : (m n : ℕ) → eqℕ m n ≡ true → m ≡ n
  eqℕ-sound zero    zero    _ = refl
  eqℕ-sound zero    (suc n) p = rec (false≢true p)
  eqℕ-sound (suc m) zero    p = rec (false≢true p)
  eqℕ-sound (suc m) (suc n) p = cong suc (eqℕ-sound m n p)

  ∈?-++ : (x : ℕ) (M N : List ℕ) → (x ∈? (M ++ N)) ≡ orB (x ∈? M) (x ∈? N)
  ∈?-++ x []       N = refl
  ∈?-++ x (y ∷ ys) N with eqℕ x y
  ... | true  = refl
  ... | false = ∈?-++ x ys N

  ∈?-single : (x a : ℕ) → (x ∈? (a ∷ [])) ≡ eqℕ x a
  ∈?-single x a with eqℕ x a
  ... | true  = refl
  ... | false = refl

  ifB-orB : (b s : Bool) → ifB b true s ≡ orB b s
  ifB-orB true  s = refl
  ifB-orB false s = refl

  ∈?-cons : (q a : ℕ) (L : List ℕ) → (q ∈? (a ∷ L)) ≡ orB (eqℕ q a) (q ∈? L)
  ∈?-cons q a L = ifB-orB (eqℕ q a) (q ∈? L)

  -- a member of xs is a member of any superset (via ⊆?).
  ⊆?-mem : (xs L : List ℕ) (x : ℕ) → (xs ⊆? L) ≡ true → (x ∈? xs) ≡ true → (x ∈? L) ≡ true
  ⊆?-mem []       L x _ q = rec (false≢true q)
  ⊆?-mem (y ∷ ys) L x h q = lemma (eqℕ x y) refl
    where
      hy  = fst (andB-split (y ∈? L) (ys ⊆? L) h)
      hys = snd (andB-split (y ∈? L) (ys ⊆? L) h)
      lemma : (b : Bool) → b ≡ eqℕ x y → (x ∈? L) ≡ true
      lemma true  eq = subst (λ z → (z ∈? L) ≡ true) (sym (eqℕ-sound x y (sym eq))) hy
      lemma false eq = ⊆?-mem ys L x hys
                         (subst (λ b → ifB b true (x ∈? ys) ≡ true) (sym eq) q)

  -- The core scan: threads `consumedIds` (ids of already-scanned events)
  -- alongside `backwardGo`'s `seen`, linked by `sameMem`.
  go : (es : List RawEvent) (seen consumedIds : List ℕ)
     → (∀ q → (q ∈? seen) ≡ (q ∈? consumedIds))
     → backwardGo seen es ≡ true
     → (c : ℕ) → (c ∈? evIdsOf es) ≡ true → (c ∈? consumedIds) ≡ false
     → (p : ℕ) → (p ∈? evParents (firstEvent c es)) ≡ true
     → idx p (consumedIds ++ evIdsOf es) < idx c (consumedIds ++ evIdsOf es)
  go [] seen consumedIds _ _ c cIn _ p _ = rec (false≢true cIn)
  go (h ∷ rest) seen consumedIds sameMem bwd c cIn cFresh p pHyp =
    lemma (eqℕ (evId h) c) refl
    where
      split = andB-split (evParents h ⊆? seen) (backwardGo (evId h ∷ seen) rest) bwd
      hHead = fst split
      hTail = snd split
      lemma : (b : Bool) → b ≡ eqℕ (evId h) c
            → idx p (consumedIds ++ evIdsOf (h ∷ rest))
            < idx c (consumedIds ++ evIdsOf (h ∷ rest))
      lemma true eq =
        idx-prefix-lt consumedIds (evIdsOf (h ∷ rest)) p c pInConsumed cFresh
        where
          -- firstEvent c (h ∷ rest) = h here, so pHyp : p ∈? evParents h
          pInH : (p ∈? evParents h) ≡ true
          pInH = subst (λ e → (p ∈? evParents e) ≡ true)
                       (cong (λ b → ifB b h (firstEvent c rest)) (sym eq)) pHyp
          pInConsumed : (p ∈? consumedIds) ≡ true
          pInConsumed = sym (sameMem p) ∙ ⊆?-mem (evParents h) seen p hHead pInH
      lemma false eq =
        subst (λ L → idx p L < idx c L) listEq
              (go rest (evId h ∷ seen) (consumedIds ++ (evId h ∷ []))
                  sameMem' hTail c cInRest cFresh' p pHyp')
        where
          eqhc : eqℕ (evId h) c ≡ false
          eqhc = sym eq
          eqch : eqℕ c (evId h) ≡ false
          eqch = eqℕ-sym c (evId h) ∙ eqhc
          sameMem' : ∀ q → (q ∈? (evId h ∷ seen)) ≡ (q ∈? (consumedIds ++ (evId h ∷ [])))
          sameMem' q =
            ∈?-cons q (evId h) seen
            ∙ cong (orB (eqℕ q (evId h))) (sameMem q)
            ∙ orB-comm (eqℕ q (evId h)) (q ∈? consumedIds)
            ∙ sym (∈?-++ q consumedIds (evId h ∷ [])
                   ∙ cong (orB (q ∈? consumedIds)) (∈?-single q (evId h)))
          cInRest : (c ∈? evIdsOf rest) ≡ true
          cInRest = subst (λ b → ifB b true (c ∈? evIdsOf rest) ≡ true) eqch cIn
          cFresh' : (c ∈? (consumedIds ++ (evId h ∷ []))) ≡ false
          cFresh' = ∈?-++ c consumedIds (evId h ∷ [])
                    ∙ cong₂ orB cFresh (∈?-single c (evId h) ∙ eqch)
          pHyp' : (p ∈? evParents (firstEvent c rest)) ≡ true
          pHyp' = subst (λ e → (p ∈? evParents e) ≡ true)
                        (cong (λ b → ifB b h (firstEvent c rest)) eqhc) pHyp
          listEq : (consumedIds ++ (evId h ∷ [])) ++ evIdsOf rest
                 ≡ consumedIds ++ evIdsOf (h ∷ rest)
          listEq = ++-assoc consumedIds (evId h ∷ []) (evIdsOf rest)

------------------------------------------------------------------------
-- The core lemma, over the full event list (consumedIds = []).
--
-- If a trace's events satisfy `backwardOK`, then for any child id `c`
-- present in the trace and any parent `p` of `c`'s first event, `p` has a
-- strictly smaller first-occurrence index than `c`.
------------------------------------------------------------------------

edge-decreases-idx :
  (es : List RawEvent) → backwardOK es ≡ true →
  (c : ℕ) → (c ∈? evIdsOf es) ≡ true →
  (p : ℕ) → (p ∈? evParents (firstEvent c es)) ≡ true →
  idx p (evIdsOf es) < idx c (evIdsOf es)
edge-decreases-idx es bwd c cIn p pHyp =
  go es [] [] (λ _ → refl) bwd c cIn refl p pHyp
