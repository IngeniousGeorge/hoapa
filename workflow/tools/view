#!/usr/bin/env python3
"""
tools/view — emit context sections matching tag filters as a markdown stream.

Usage:
    tools/view focus:concurrency kind:decision
    tools/view --root workflow/ focus:modalhott freshness:hot
    tools/view focus:concurrency > /tmp/ctx-concurrency.md

Conventions (v0 — revise here as we go):
- File-level tags: YAML frontmatter `tags: [dim:value, ...]` between `---` markers.
- Section-level tags: an HTML comment `<!-- tags: dim:value, dim:value -->`
  placed immediately above a heading (blank lines between are fine).
- Section boundary: from a heading until the next heading of any level.
  Each heading is its own atomic section; subsections do NOT include nested
  text. Adjust if this becomes a real friction.
- Tag inheritance: section tags merge with file tags; section overrides file
  per-dimension. Subsections inherit from the FILE only, not from a parent
  section. (Revisit if this bites.)
- Filters AND together. Each argument is `dim:value`; exact match required.
"""

import argparse
import re
import sys
from pathlib import Path

SECTION_TAG_RE = re.compile(r"<!--\s*tags:\s*(.+?)\s*-->", re.IGNORECASE)
HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*$")


def find_root(explicit):
    if explicit:
        return Path(explicit)
    # tools/ lives inside the context root; the script's grandparent IS the root.
    parent = Path(__file__).resolve().parent.parent
    if parent.name in ("context", "workflow"):
        return parent
    # fallback: tools/ is a sibling of the context root
    for name in ("context", "workflow"):
        candidate = parent / name
        if candidate.is_dir():
            return candidate
    sys.exit(f"no context root found near {parent} (looked for context/, workflow/)")


def parse_frontmatter(text):
    """Return (frontmatter_dict, body). Minimal YAML — keys + flat lists only."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text
    fm = {}
    for line in text[4:end].splitlines():
        m = re.match(r"^(\w+):\s*(.*)$", line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val.startswith("[") and val.endswith("]"):
            fm[key] = [v.strip().strip("\"'") for v in val[1:-1].split(",") if v.strip()]
        else:
            fm[key] = val.strip("\"'")
    return fm, text[end + 5:]


def kv_list_to_dict(items):
    """['focus:concurrency', 'kind:decision'] → {'focus': 'concurrency', 'kind': 'decision'}"""
    out = {}
    for entry in items:
        if ":" in entry:
            dim, val = entry.split(":", 1)
            out[dim.strip()] = val.strip()
    return out


def extract_sections(body, file_tags):
    lines = body.splitlines()
    sections = []
    pending = None  # tags from <!-- tags: ... --> seen above a heading
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        m_tag = SECTION_TAG_RE.match(stripped)
        if m_tag:
            pending = kv_list_to_dict([x.strip() for x in m_tag.group(1).split(",")])
            i += 1
            continue
        m_h = HEADING_RE.match(line)
        if m_h:
            tags = dict(file_tags)
            if pending:
                tags.update(pending)
                pending = None
            start = i
            j = i + 1
            while j < len(lines) and not HEADING_RE.match(lines[j]):
                j += 1
            sections.append({
                "heading": m_h.group(2),
                "tags": tags,
                "line": start + 1,
                "content": "\n".join(lines[start:j]),
            })
            i = j
        else:
            if stripped:
                pending = None  # any non-blank non-tag line drops the pending tags
            i += 1
    return sections


def main():
    ap = argparse.ArgumentParser(description="Emit context sections matching tag filters.")
    ap.add_argument("--root", help="context root (default: auto-detect context/ or workflow/)")
    ap.add_argument("filters", nargs="+", help="filters of the form dim:value (AND-ed)")
    args = ap.parse_args()

    root = find_root(args.root)
    filters = kv_list_to_dict(args.filters)
    if not filters:
        sys.exit("no valid filters parsed; expected dim:value")

    matched = 0
    header = " ".join(f"{k}:{v}" for k, v in filters.items())
    print(f"<!-- view: {header} | root: {root} -->\n")
    for path in sorted(root.rglob("*.md")):
        text = path.read_text(encoding="utf-8")
        fm, body = parse_frontmatter(text)
        raw_tags = fm.get("tags", [])
        file_tags = kv_list_to_dict(raw_tags if isinstance(raw_tags, list) else [])
        for sec in extract_sections(body, file_tags):
            if all(sec["tags"].get(k) == v for k, v in filters.items()):
                rel = path.relative_to(root.parent)
                tags_str = ", ".join(f"{k}:{v}" for k, v in sorted(sec["tags"].items()))
                print(f"---\n**{rel}:{sec['line']}** — `{tags_str}`\n")
                print(sec["content"])
                print()
                matched += 1
    print(f"<!-- {matched} section(s) matched -->", file=sys.stderr)


if __name__ == "__main__":
    main()
