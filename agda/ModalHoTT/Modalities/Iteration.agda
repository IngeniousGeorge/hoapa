{-# OPTIONS --cubical --guardedness #-}

-- Iterated unit of a generic adjunction; the "developing network" as a
-- sequential colimit. Infrastructure for T_recursion (workflow/targets.md).
--
-- T_recursion's claim is that the unit η of the cross-site adjunction
-- Allow ⊣ Require iterates coherently, and the colimit of the resulting
-- tower is the math fragment's "infinite developing network"
-- (arc.md §6: covers / recursion / developing network).
--
-- This file is parameterized over an arbitrary adjunction L ⊣ R given by
-- functoriality data plus a unit η. The cross-site adjunction is not yet
-- stated in Agda (Concurrency side is scoping); when it is, it instantiates
-- this module. In the meantime the A-side adjunctions (ʃ ⊣ ♭, ♭ ⊣ ♯) can
-- be specialized as sanity checks — iteration collapses to T A by
-- idempotency, the expected (trivial) result.
--
-- Deferred:
--   • Cyclic-operad involution (the 1=2 perspective swap) — would
--     become a separate `CyclicIteration.agda` once the iteration
--     content is non-trivially populated by the cross-site adjunction.
--   • B-side dual: limit of the iterated counit of the comonad L ∘ R.
--     The 1=2 identity is conjecturally the equivalence between this
--     limit and the A-side colimit via the adjunction. Flagged in
--     future_work.md.

module ModalHoTT.Modalities.Iteration where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc)
open import Cubical.Data.Sequence using (Sequence)
open import Cubical.HITs.SequentialColimit using (SeqColim)

------------------------------------------------------------------------
-- The iteration module
--
-- Parameterized over an arbitrary adjunction L ⊣ R. Only the structure
-- needed for the iteration is requested: functoriality of L and R, and
-- the unit η. Full triangle identities are not required at this layer.
------------------------------------------------------------------------

module Iteration
  {ℓ ℓ' : Level}
  (L     : Type ℓ → Type ℓ')
  (R     : Type ℓ' → Type ℓ)
  (L-map : ∀ {A B : Type ℓ}  → (A → B) → L A → L B)
  (R-map : ∀ {X Y : Type ℓ'} → (X → Y) → R X → R Y)
  (η     : ∀ {A : Type ℓ} → A → R (L A))
  where

  ----------------------------------------------------------------------
  -- Induced monad  T = R ∘ L  on the source side
  ----------------------------------------------------------------------

  T : Type ℓ → Type ℓ
  T A = R (L A)

  T-map : ∀ {A B : Type ℓ} → (A → B) → T A → T B
  T-map f = R-map (L-map f)

  ----------------------------------------------------------------------
  -- n-fold iterate  T^n
  ----------------------------------------------------------------------

  T^_ : ℕ → Type ℓ → Type ℓ
  (T^ zero)    A = A
  (T^ (suc n)) A = T ((T^ n) A)

  ----------------------------------------------------------------------
  -- Iterated unit  η^_n : id → T^n
  --
  -- "From the inside": build T^n a first, then apply η at level n.
  -- An equivalent "from the outside" form (`T-map (η^_n) ∘ η`) is
  -- derived below as `η^-coherent` from η-naturality.
  ----------------------------------------------------------------------

  η^_ : (n : ℕ) {A : Type ℓ} → A → (T^ n) A
  (η^ zero)    a = a
  (η^ (suc n)) a = η ((η^ n) a)

  ----------------------------------------------------------------------
  -- η-naturality  (postulated, load-bearing)
  --
  -- In any genuine adjunction η is a natural transformation by
  -- definition. Postulated here because the generic Adjunction
  -- interface in this module does not bundle naturality — same gap
  -- as `shape-flat-natural-B` in Properties.agda; same resolution
  -- (becomes a theorem once adjunction-naturality is recorded;
  -- status.md Open Questions).
  ----------------------------------------------------------------------

  postulate
    η-naturality : {A B : Type ℓ} (f : A → B) (a : A)
                 → T-map f (η a) ≡ η (f a)

  ----------------------------------------------------------------------
  -- Operadic associator for the iteration:
  --   η^_{n+1} ≡ T-map (η^_n) ∘ η
  --
  -- "Iterate from inside" agrees with "iterate from outside."
  -- Derived from η-naturality.
  ----------------------------------------------------------------------

  η^-coherent : (n : ℕ) {A : Type ℓ} (a : A)
              → (η^ (suc n)) a ≡ T-map (η^ n) (η a)
  η^-coherent n a = sym (η-naturality (η^ n) a)

  ----------------------------------------------------------------------
  -- The developing network as a sequential colimit
  --
  -- Underlying sequence:   A → T A → T² A → T³ A → …
  -- Structure map at each level: η.
  --
  -- The colimit is the candidate type the "math fragment" of arc.md §6
  -- names — the infinite developing network generated by recursive
  -- application of the adjunction's unit.
  ----------------------------------------------------------------------

  T-sequence : Type ℓ → Sequence ℓ
  Sequence.obj (T-sequence A) n = (T^ n) A
  Sequence.map (T-sequence A) x = η x

  ND : Type ℓ → Type ℓ
  ND A = SeqColim (T-sequence A)
